// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ────────────────────────────────────

enum MovementType {
  ENTRADA
  SALIDA
  TRASLADO
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  DEVOLUCION_COMPRA
  DEVOLUCION_VENTA
  CONSUMO_OBRA
  DEVOLUCION_OBRA
}

enum MovementStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ValuationMethod {
  FIFO
  LIFO
  AVERAGE
}

enum ProductType {
  MATERIAL
  TOOL
  MACHINERY
  CONSUMABLE
}

enum WarehouseType {
  CENTRAL
  PROJECT_SITE
  TRANSIT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  FINISHED
}

enum WorkerRole {
  MAESTRO_MAYOR
  ALBANIL
  AYUDANTE
  ELECTRICISTA
  PLOMERO
  CARPINTERO
  FIERRERO
  PINTOR
  CHOFER
  GUARDIA
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  EXTRA
}

enum AssignmentStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
}

// ── AUTH ─────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  refreshToken String?   @map("refresh_token")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  userRoles          UserRole[]
  movements          Movement[]
  auditLogs          AuditLog[]
  assignedRoles      UserRole[]        @relation("AssignedBy")
  supervisedProjects Project[]
  attendancesLogged  DailyAttendance[] @relation("RegisteredBy")
  toolAssignments    ToolAssignment[]  @relation("AssignedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ── MAESTROS ─────────────────────────────────

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  parentId    String?    @map("parent_id")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Unit {
  id           String  @id @default(uuid())
  name         String
  abbreviation String
  isActive     Boolean @default(true) @map("is_active")

  products Product[]

  @@map("units")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  taxId     String?  @map("tax_id")
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  movements Movement[]

  @@map("suppliers")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  idNumber  String?  @map("id_number")
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  movements Movement[]
  projects  Project[]

  @@map("clients")
}

model Warehouse {
  id            String        @id @default(uuid())
  name          String
  code          String        @unique
  location      String?
  isMain        Boolean       @default(false) @map("is_main")
  isActive      Boolean       @default(true) @map("is_active")
  warehouseType WarehouseType @default(CENTRAL) @map("warehouse_type")
  projectId     String?       @map("project_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  project         Project?    @relation(fields: [projectId], references: [id])
  inventory       Inventory[]
  kardex          Kardex[]
  movementsOrigin Movement[]  @relation("origin")
  movementsDest   Movement[]  @relation("destination")

  @@map("warehouses")
}

// ── OBRAS ─────────────────────────────────────

model Project {
  id               String        @id @default(uuid())
  name             String
  code             String        @unique
  address          String?
  clientId         String?       @map("client_id")
  supervisorId     String?       @map("supervisor_id")
  status           ProjectStatus @default(PLANNING)
  startDate        DateTime?     @map("start_date")
  estimatedEndDate DateTime?     @map("estimated_end_date")
  actualEndDate    DateTime?     @map("actual_end_date")
  budget           Decimal?      @db.Decimal(14, 2)
  notes            String?
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  client          Client?           @relation(fields: [clientId], references: [id])
  supervisor      User?             @relation(fields: [supervisorId], references: [id])
  movements       Movement[]
  warehouses      Warehouse[]
  dailyAttendance DailyAttendance[]
  toolAssignments ToolAssignment[]

  @@map("projects")
}

// ── TRABAJADORES ──────────────────────────────

model Worker {
  id         String     @id @default(uuid())
  fullName   String     @map("full_name")
  idNumber   String?    @unique @map("id_number")
  workerRole WorkerRole @map("worker_role")
  dailyRate  Decimal    @db.Decimal(8, 2) @map("daily_rate")
  phone      String?
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  dailyAttendance DailyAttendance[]

  @@map("workers")
}

model DailyAttendance {
  id           String           @id @default(uuid())
  workerId     String           @map("worker_id")
  projectId    String           @map("project_id")
  date         DateTime
  status       AttendanceStatus
  hoursWorked  Decimal?         @db.Decimal(4, 2) @map("hours_worked")
  dailyCost    Decimal          @db.Decimal(8, 2) @map("daily_cost")
  registeredBy String?          @map("registered_by")
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  worker           Worker  @relation(fields: [workerId], references: [id])
  project          Project @relation(fields: [projectId], references: [id])
  registeredByUser User?   @relation("RegisteredBy", fields: [registeredBy], references: [id])

  @@unique([workerId, projectId, date])
  @@map("daily_attendance")
}

model ToolAssignment {
  id           String           @id @default(uuid())
  productId    String           @map("product_id")
  projectId    String           @map("project_id")
  assignedDate DateTime         @map("assigned_date")
  returnedDate DateTime?        @map("returned_date")
  quantity     Decimal          @db.Decimal(8, 2)
  status       AssignmentStatus @default(ASSIGNED)
  notes        String?
  assignedBy   String?          @map("assigned_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  product        Product @relation(fields: [productId], references: [id])
  project        Project @relation(fields: [projectId], references: [id])
  assignedByUser User?   @relation("AssignedBy", fields: [assignedBy], references: [id])

  @@map("tool_assignments")
}

// ── PRODUCTOS ─────────────────────────────────

model Product {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  description     String?
  categoryId      String          @map("category_id")
  unitId          String          @map("unit_id")
  imageUrl        String?         @map("image_url")
  barcode         String?         @unique
  costPrice       Decimal         @db.Decimal(12, 4) @map("cost_price")
  salePrice       Decimal         @db.Decimal(12, 4) @map("sale_price")
  minStock        Decimal         @default(0) @db.Decimal(12, 4) @map("min_stock")
  valuationMethod ValuationMethod @default(AVERAGE) @map("valuation_method")
  productType     ProductType     @default(MATERIAL) @map("product_type")
  isConsumable    Boolean         @default(true) @map("is_consumable")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id])
  unit            Unit             @relation(fields: [unitId], references: [id])
  movementDetails MovementDetail[]
  inventory       Inventory[]
  kardex          Kardex[]
  toolAssignments ToolAssignment[]

  @@map("products")
}

// ── INVENTARIO ACTUAL ─────────────────────────

model Inventory {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  warehouseId String   @map("warehouse_id")
  quantity    Decimal  @default(0) @db.Decimal(12, 4)
  avgCost     Decimal  @default(0) @db.Decimal(12, 4) @map("avg_cost")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("inventory")
}

// ── MOVIMIENTOS ───────────────────────────────

model Movement {
  id              String         @id @default(uuid())
  referenceNumber String         @unique @map("reference_number")
  type            MovementType
  status          MovementStatus @default(DRAFT)
  documentType    String?        @map("document_type")
  documentNumber  String?        @map("document_number")
  warehouseId     String         @map("warehouse_id")
  warehouseDestId String?        @map("warehouse_dest_id")
  supplierId      String?        @map("supplier_id")
  clientId        String?        @map("client_id")
  projectId       String?        @map("project_id")
  userId          String         @map("user_id")
  notes           String?
  movementDate    DateTime       @default(now()) @map("movement_date")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  warehouse     Warehouse        @relation("origin", fields: [warehouseId], references: [id])
  warehouseDest Warehouse?       @relation("destination", fields: [warehouseDestId], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  client        Client?          @relation(fields: [clientId], references: [id])
  project       Project?         @relation(fields: [projectId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  details       MovementDetail[]

  @@map("movements")
}

model MovementDetail {
  id          String    @id @default(uuid())
  movementId  String    @map("movement_id")
  productId   String    @map("product_id")
  quantity    Decimal   @db.Decimal(12, 4)
  unitCost    Decimal   @db.Decimal(12, 4) @map("unit_cost")
  totalCost   Decimal   @db.Decimal(12, 4) @map("total_cost")
  batchNumber String?   @map("batch_number")
  expiryDate  DateTime? @map("expiry_date")

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  kardex   Kardex[]

  @@map("movement_details")
}

// ── KARDEX ────────────────────────────────────

model Kardex {
  id               String       @id @default(uuid())
  productId        String       @map("product_id")
  warehouseId      String       @map("warehouse_id")
  movementDetailId String       @map("movement_detail_id")
  movementType     MovementType @map("movement_type")

  inQuantity  Decimal? @db.Decimal(12, 4) @map("in_quantity")
  inUnitCost  Decimal? @db.Decimal(12, 4) @map("in_unit_cost")
  inTotal     Decimal? @db.Decimal(12, 4) @map("in_total")

  outQuantity Decimal? @db.Decimal(12, 4) @map("out_quantity")
  outUnitCost Decimal? @db.Decimal(12, 4) @map("out_unit_cost")
  outTotal    Decimal? @db.Decimal(12, 4) @map("out_total")

  balanceQuantity Decimal @db.Decimal(12, 4) @map("balance_quantity")
  balanceUnitCost Decimal @db.Decimal(12, 4) @map("balance_unit_cost")
  balanceTotal    Decimal @db.Decimal(12, 4) @map("balance_total")

  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  product        Product        @relation(fields: [productId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  movementDetail MovementDetail @relation(fields: [movementDetailId], references: [id])

  @@index([productId, warehouseId, date])
  @@map("kardex")
}

// ── AUDIT LOG ─────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}